# 复制为 .env 后在 Cloud Studio 编辑。密钥只保存在该未跟踪文件中。
# Qwen URL 填完整的 OpenAI-compatible chat/completions 地址。
QWEN_VL_API_URL=""
QWEN_VL_API_KEY=""
QWEN_VL_MODEL="Qwen2.5-VL-72B-Instruct"
OCR_API_URL=""
OCR_API_KEY=""
OCR_MODEL="HunyuanOCR"
# openai: 兼容聊天接口；paddleocr: AI Studio 的 PaddleOCR-VL 同步原生接口。
# 选择 paddleocr 时，OCR_API_URL / OCR_API_KEY 填官方 API 示例中的 API_URL / TOKEN。
OCR_API_STYLE="openai"

APP_PORT=8080
ML_BACKEND_PORT=9090
# 如预览页面出现重定向/静态资源地址错误，再填写真实的预览 HTTPS 根地址。
LABEL_STUDIO_HOST=""

# 可选：提前创建登录账号。留空时第一次打开页面自行注册。
LABEL_STUDIO_USERNAME=""
LABEL_STUDIO_PASSWORD=""

# 登录后在 Account & Settings 查看 API Token，再填入以运行导入脚本。
LABEL_STUDIO_API_KEY=""
